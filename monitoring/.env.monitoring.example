# Copy this file to devops/environments/.env.monitoring and fill in all values.
# Start the stack with:
#   docker compose --env-file ./environments/.env.monitoring -f docker-compose.monitoring.yml up -d

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ── SMTP (Gmail) ───────────────────────────────────────────────────────────────
# Generate an App Password at https://myaccount.google.com/apppasswords
# Use port 587 (STARTTLS). Port 465 (SSL) is not used here.
GF_SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-char-app-password
GF_SMTP_FROM_ADDRESS=your-sender@gmail.com
GF_SMTP_FROM_NAME=Rythmify Monitoring

# ── Alert recipient ────────────────────────────────────────────────────────────
ALERT_EMAIL_TO=oncall@example.com

# ── Alertmanager SMTP ─────────────────────────────────────────────────────────
# Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
# WARNING: do NOT use special characters in this value — envsubst will break
# if the password contains /, &, @, or $. Gmail App Passwords (16 lowercase
# letters, no punctuation) are safe by default.
ALERTMANAGER_SMTP_PASSWORD=your_gmail_app_password_here

# ── PostgreSQL exporter ────────────────────────────────────────────────────────
# rythmify_admin must have the pg_monitor role on VM2:
#   GRANT pg_monitor TO rythmify_admin;
POSTGRES_PASSWORD=your_postgres_password_here
